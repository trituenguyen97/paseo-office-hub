{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts",
    "*.tsx",
    "client",
    "server",
    "shared",
    "test"
  ]
}
